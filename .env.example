# Servidor
HOST=127.0.0.1
PORT=3000
TZ=America/Sao_Paulo
DATABASE_PATH=./data/sigen.db
# Opcional: por padrão as fotos ficam em ./data/fotos (ao lado do SQLite).
# PHOTOS_DIR=./data/fotos
# Opcional: por padrão os PDFs das GTAs ficam em ./data/gta.
# GTA_DIR=./data/gta

# GTA: 0 (padrão) só confere a tela do SIGEN; 1 habilita a emissão de verdade.
GTA_EMISSAO_ATIVA=0

# SIGEN+
SIGEN_BASE_URL=https://sigen.cidasc.sc.gov.br
SIGEN_USUARIO=
SIGEN_SENHA=
# Alternativa ao usuário/senha no desenvolvimento: sessão salva por `npm run sigen:login`
SIGEN_STORAGE_STATE=.auth/state.json
SIGEN_IDLE_MINUTES=20

# Use 1 para desenvolver a interface sem credenciais do SIGEN.
# Serve o inventário a partir de fixtures/inventory.
SIGEN_MOCK=0
