# Servidor
HOST=127.0.0.1
PORT=3000
TZ=America/Sao_Paulo
DATABASE_PATH=./data/sigen.db

# SIGEN+
SIGEN_BASE_URL=https://sigen.cidasc.sc.gov.br
SIGEN_USUARIO=
SIGEN_SENHA=
# Alternativa ao usuário/senha no desenvolvimento: sessão salva por `npm run sigen:login`
SIGEN_STORAGE_STATE=.auth/state.json
SIGEN_IDLE_MINUTES=20

# Use 1 para desenvolver a interface sem credenciais do SIGEN.
# Serve o inventário a partir de fixtures/inventory.
SIGEN_MOCK=0
