{
  "name": "@sigen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "sigen:login": "tsx scripts/login.ts",
    "sigen:check": "tsx scripts/check.ts",
    "sigen:inspect": "tsx scripts/inspect-ueps.ts",
    "sigen:gta:check": "tsx scripts/check-gta.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@sigen/contracts": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "playwright": "1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
